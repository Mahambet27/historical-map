VITE_MAPBOX_TOKEN=YOUR_PUBLIC_MAPBOX_TOKEN_HERE
VITE_APP_NAME=Qazaq Heritage Map
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_HISTORICAL_DATA_SOURCE=auto
VITE_SENTRY_DSN=

# Atlas only: remote uses the temporary public development basemap.
# self-hosted requests same-origin assets and falls back to SVG if unavailable.
VITE_ATLAS_BASEMAP_MODE=remote
VITE_ATLAS_STYLE_URL=/maps/style.json

# Optional local Terrarium DEM; missing assets retain the 2D basemap.
VITE_ATLAS_TERRAIN_ENABLED=false
