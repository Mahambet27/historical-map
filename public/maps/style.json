{
  "version": 8,
  "name": "Atlas Kazakhstan local vector basemap",
  "metadata": {
    "atlas:contract": "OpenMapTiles-compatible XYZ, Kazakhstan coverage; deploy tiles and glyphs before enabling self-hosted"
  },
  "center": [67, 48],
  "zoom": 4,
  "glyphs": "/maps/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "atlas-basemap": {
      "type": "vector",
      "tiles": ["/maps/tiles/{z}/{x}/{y}.pbf"],
      "scheme": "xyz",
      "minzoom": 0,
      "maxzoom": 14,
      "bounds": [45, 39, 90, 57],
      "attribution": "© OpenStreetMap contributors · OpenMapTiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101b23"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "atlas-basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#183341"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "atlas-basemap",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#30566a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.5, 14, 2]
      }
    },
    {
      "id": "administrative-boundaries",
      "type": "line",
      "source": "atlas-basemap",
      "source-layer": "boundary",
      "minzoom": 5,
      "filter": [">", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#71808a",
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "country-boundaries",
      "type": "line",
      "source": "atlas-basemap",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#99a2a5",
        "line-width": 1.4
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "atlas-basemap",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#65645b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 10, 1.3, 14, 3]
      }
    },
    {
      "id": "settlements",
      "type": "circle",
      "source": "atlas-basemap",
      "source-layer": "place",
      "minzoom": 4,
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "village", "hamlet"]]],
      "paint": {
        "circle-radius": 2,
        "circle-color": "#c7c8bb"
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "atlas-basemap",
      "source-layer": "place",
      "minzoom": 4,
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "village", "hamlet"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name:en"], ""],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 12, 15],
        "text-anchor": "top",
        "text-offset": [0, 0.5],
        "text-max-width": 8,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99]
      },
      "paint": {
        "text-color": "#e0dfd2",
        "text-halo-color": "#101b23",
        "text-halo-width": 1.5
      }
    }
  ]
}
